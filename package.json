{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/**/*.test.ts server/*.test.ts scripts/*.test.mjs",
    "clean": "node -e \"for(const d of ['dist']) require('fs').rmSync(d,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "start": "tsx server.ts --prod",
    "build:api": "esbuild server/vercel/chat.ts server/vercel/health.ts server/vercel/feedback.ts --bundle --platform=node --format=esm --target=node20 --outdir=api --out-extension:.js=.js --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "build:vercel": "vite build && npm run build:api",
    "scenarios": "node scripts/scenario-test.mjs",
    "feedback:export": "node scripts/feedback-export.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}

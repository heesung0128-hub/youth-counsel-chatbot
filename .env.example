# ---------------------------------------------------------------
# AI (OpenAI) — 답변을 만드는 AI
# Vercel: Project Settings → Environment Variables 에 넣고 재배포하세요.
# OPENAI_API_KEY 가 없으면 AI 없이 내장 응답(규칙 기반 위기 안내 포함)으로만 동작합니다.
# ---------------------------------------------------------------
OPENAI_API_KEY=""
# Optional: model (default: gpt-6-luna — cheapest/fastest; e.g. gpt-6.1-sol for higher quality)
#OPENAI_MODEL="gpt-6-luna"
# Optional: reasoning effort none | low | medium | high (default: low). Higher = follows rules better, slower, costlier.
#OPENAI_REASONING_EFFORT="low"
# Optional: regional endpoint (default: https://api.openai.com/v1), e.g. https://us.api.openai.com/v1
#OPENAI_BASE_URL="https://api.openai.com/v1"
# Optional: AI call timeout in ms (default: 20000). Keep below the 30s Vercel function limit.
#AI_TIMEOUT_MS=20000

# ---------------------------------------------------------------
# 요청 횟수 제한 · 피드백 저장 (Upstash Redis)
# Vercel Marketplace의 Upstash 연동 시 자동으로 들어갑니다. 없으면 제한 없이 동작(로컬 개발용).
# ---------------------------------------------------------------
#KV_REST_API_URL=""
#KV_REST_API_TOKEN=""
# Optional limits: per IP per minute / per IP per day / all users per day
# Keep RATE_LIMIT_GLOBAL_PER_DAY x cost per message within your daily budget.
#RATE_LIMIT_PER_MIN=20
#RATE_LIMIT_PER_DAY=300
#RATE_LIMIT_GLOBAL_PER_DAY=450

# ---------------------------------------------------------------
# 피드백 조회 (교사용). 긴 임의 문자열을 넣고: npm run feedback:export
# ---------------------------------------------------------------
#FEEDBACK_ADMIN_TOKEN=""
